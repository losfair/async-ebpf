def imm_ok (opcode : Std.U8) (f : Filter) (imm : Std.I32) : Result Bool := do
  if opcode = 219#u8
  then
    if imm = 0#i32
    then ok true
    else
      if imm = 1#i32
      then ok true
      else
        if imm = 64#i32
        then ok true
        else
          if imm = 65#i32
          then ok true
          else
            if imm = 80#i32
            then ok true
            else
              if imm = 81#i32
              then ok true
              else
                if imm = 160#i32
                then ok true
                else
                  if imm = 161#i32
                  then ok true
                  else if imm = 225#i32
                       then ok true
                       else ok (imm = 241#i32)
  else if imm >= f.imm_lo
       then ok (imm <= f.imm_hi)
       else ok false

