def check_atomic_selector
  (insn : Insn) (pc : Std.Usize) :
  Result (core.result.Result Unit Reject)
  := do
  let i ← lift (insn.imm &&& ATOMIC_OP_FETCH)
  let i1 ← lift (UScalar.hcast .I32 ALU_MASK)
  let op ← lift (insn.imm &&& i1)
  let i2 ← lift (UScalar.hcast .I32 ALU_ADD)
  if op = i2
  then ok (core.result.Result.Ok ())
  else
    let i3 ← lift (UScalar.hcast .I32 ALU_OR)
    if op = i3
    then ok (core.result.Result.Ok ())
    else
      let i4 ← lift (UScalar.hcast .I32 ALU_AND)
      if op = i4
      then ok (core.result.Result.Ok ())
      else
        let i5 ← lift (UScalar.hcast .I32 ALU_XOR)
        if op = i5
        then ok (core.result.Result.Ok ())
        else
          let i6 ← lift (~~~ ATOMIC_OP_FETCH)
          let i7 ← lift (ATOMIC_OP_XCHG &&& i6)
          if op = i7
          then
            if i != 0#i32
            then ok (core.result.Result.Ok ())
            else ok (core.result.Result.Err (Reject.AtomicNeedsFetch pc))
          else
            let i8 ← lift (~~~ ATOMIC_OP_FETCH)
            let i9 ← lift (ATOMIC_OP_CMPXCHG &&& i8)
            if op = i9
            then
              if i != 0#i32
              then ok (core.result.Result.Ok ())
              else ok (core.result.Result.Err (Reject.AtomicNeedsFetch pc))
            else ok (core.result.Result.Err (Reject.AtomicUnknown pc))

