def offset_ok
  (opcode : Std.U8) (f : Filter) (offset : Std.I16) : Result Bool := do
  if opcode = 188#u8
  then
    if offset = 0#i16
    then ok true
    else if offset = 8#i16
         then ok true
         else ok (offset = 16#i16)
  else
    if opcode = 191#u8
    then
      if offset = 0#i16
      then ok true
      else
        if offset = 8#i16
        then ok true
        else if offset = 16#i16
             then ok true
             else ok (offset = 32#i16)
    else if offset >= f.off_lo
         then ok (offset <= f.off_hi)
         else ok false

