def check_operand_filter
  (insn : Insn) (pc : Std.Usize) :
  Result (core.result.Result Unit Reject)
  := do
  let o ← filter_for insn.opcode
  match o with
  | none => ok (core.result.Result.Err (Reject.FilterOpcode pc))
  | some f =>
    if insn.dst < f.dst_lo
    then ok (core.result.Result.Err (Reject.FilterDst pc))
    else
      if insn.dst > f.dst_hi
      then ok (core.result.Result.Err (Reject.FilterDst pc))
      else
        if insn.src < f.src_lo
        then ok (core.result.Result.Err (Reject.FilterSrc pc))
        else
          if insn.src > f.src_hi
          then ok (core.result.Result.Err (Reject.FilterSrc pc))
          else
            let b ← imm_ok insn.opcode f insn.imm
            if b
            then
              let b1 ← offset_ok insn.opcode f insn.offset
              if b1
              then ok (core.result.Result.Ok ())
              else ok (core.result.Result.Err (Reject.FilterOffset pc))
            else ok (core.result.Result.Err (Reject.FilterImm pc))

