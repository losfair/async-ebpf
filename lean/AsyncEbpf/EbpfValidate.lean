            let i5 ← Slice.index_usize insns i4
            if i5.opcode = 0#u8
            then ok (core.result.Result.Err (Reject.CallIntoLddw pc))
            else ok (core.result.Result.Ok ())
      else
        if insn.src = 2#u8
        then ok (core.result.Result.Err (Reject.BtfCall pc))
        else ok (core.result.Result.Err (Reject.CallType pc))

