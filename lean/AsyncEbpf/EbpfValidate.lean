def alu_op_from_nibble (nibble : Std.U8) : Result (Option AluOp) := do
  if nibble = ALU_ADD
  then ok (some AluOp.Add)
  else
    if nibble = ALU_SUB
    then ok (some AluOp.Sub)
    else
      if nibble = ALU_MUL
      then ok (some AluOp.Mul)
      else
        if nibble = ALU_DIV
        then ok (some AluOp.Div)
        else
          if nibble = ALU_OR
          then ok (some AluOp.Or)
          else
            if nibble = ALU_AND
            then ok (some AluOp.And)
            else
              if nibble = ALU_LSH
              then ok (some AluOp.Lsh)
              else
                if nibble = ALU_RSH
                then ok (some AluOp.Rsh)
                else
                  if nibble = ALU_NEG
                  then ok (some AluOp.Neg)
                  else
                    if nibble = ALU_MOD
                    then ok (some AluOp.Mod)
                    else
                      if nibble = ALU_XOR
                      then ok (some AluOp.Xor)
                      else
                        if nibble = ALU_MOV
                        then ok (some AluOp.Mov)
                        else
                          if nibble = ALU_ARSH
                          then ok (some AluOp.Arsh)
                          else ok none

