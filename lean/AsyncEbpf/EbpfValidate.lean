  | Op.Atomic _ => check_atomic_selector insn pc
  | Op.Ja _ =>
    let displacement ←
      if insn.opcode = OP_JA32
      then ok insn.imm
      else ok (IScalar.cast .I32 insn.offset)
    if displacement = (-1)#i32
    then ok (core.result.Result.Err (Reject.InfiniteLoop pc))
    else
      let i ← lift (UScalar.hcast .I64 pc)
      let i1 ← i + 1#i64
      let i2 ← lift (IScalar.cast .I64 displacement)
      let target ← i1 + i2
      if target < 0#i64
      then ok (core.result.Result.Err (Reject.JumpOutOfBounds pc))
      else
        let i3 ← lift (UScalar.hcast .I64 num_insns)
        if target >= i3
        then ok (core.result.Result.Err (Reject.JumpOutOfBounds pc))
        else
          let i4 ← lift (IScalar.hcast .Usize target)
          let i5 ← Slice.index_usize insns i4
          if i5.opcode = 0#u8
          then ok (core.result.Result.Err (Reject.JumpIntoLddw pc))
          else ok (core.result.Result.Ok ())
  | Op.Jmp _ _ _ =>
    let displacement ←
      if insn.opcode = OP_JA32
      then ok insn.imm
      else ok (IScalar.cast .I32 insn.offset)
    if displacement = (-1)#i32
    then ok (core.result.Result.Err (Reject.InfiniteLoop pc))
    else
      let i ← lift (UScalar.hcast .I64 pc)
      let i1 ← i + 1#i64
      let i2 ← lift (IScalar.cast .I64 displacement)
      let target ← i1 + i2
      if target < 0#i64
      then ok (core.result.Result.Err (Reject.JumpOutOfBounds pc))
      else
        let i3 ← lift (UScalar.hcast .I64 num_insns)
        if target >= i3
        then ok (core.result.Result.Err (Reject.JumpOutOfBounds pc))
        else
          let i4 ← lift (IScalar.hcast .Usize target)
          let i5 ← Slice.index_usize insns i4
          if i5.opcode = 0#u8
          then ok (core.result.Result.Err (Reject.JumpIntoLddw pc))
          else ok (core.result.Result.Ok ())
  | Op.Call =>
    let i := Slice.len external_calls
    let cross_section ←
      if pc < i
      then Slice.index_usize external_calls pc
      else ok false
    check_call config known_helpers insn insns pc cross_section
  | Op.Exit => ok (core.result.Result.Ok ())

