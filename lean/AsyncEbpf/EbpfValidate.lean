  (external_calls : Slice Bool) (pc : Std.Usize) :
  Result (core.result.Result Bool Reject)
  := do
  let insn ← Slice.index_usize insns pc
  let o ← decode insn.opcode
  match o with
  | none => ok (core.result.Result.Err (Reject.UnknownOpcode pc))
  | some op =>
    let r ←
      check_structure config known_helpers insns external_calls pc insn op
    let cf ← core.result.Result.Insts.CoreOpsTry.branch r
    match cf with
    | core.ops.control_flow.ControlFlow.Continue _ =>
      if insn.src > 10#u8
      then ok (core.result.Result.Err (Reject.InvalidSrc pc))
      else
        if insn.dst > 9#u8
