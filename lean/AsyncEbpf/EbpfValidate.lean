def check_structure
  (config : Config) (known_helpers : Slice Std.U32) (insns : Slice Insn)
  (external_calls : Slice Bool) (pc : Std.Usize) (insn : Insn) (op : Op) :
  Result (core.result.Result Unit Reject)
  := do
  let num_insns := Slice.len insns
  match op with
  | Op.Alu _ ao _ =>
    match ao with
    | AluOp.Add => ok (core.result.Result.Ok ())
    | AluOp.Sub => ok (core.result.Result.Ok ())
    | AluOp.Mul => ok (core.result.Result.Ok ())
    | AluOp.Div => ok (core.result.Result.Ok ())
    | AluOp.Or => ok (core.result.Result.Ok ())
    | AluOp.And => ok (core.result.Result.Ok ())
    | AluOp.Lsh => ok (core.result.Result.Ok ())
    | AluOp.Rsh => ok (core.result.Result.Ok ())
    | AluOp.Neg =>
      if insn.src != 0#u8
      then ok (core.result.Result.Err (Reject.NegSrc pc))
      else ok (core.result.Result.Ok ())
    | AluOp.Mod => ok (core.result.Result.Ok ())
    | AluOp.Xor => ok (core.result.Result.Ok ())
    | AluOp.Mov => ok (core.result.Result.Ok ())
    | AluOp.Arsh => ok (core.result.Result.Ok ())
  | Op.End _ =>
    if insn.imm != 16#i32
    then
      if insn.imm != 32#i32
      then
        if insn.imm != 64#i32
        then ok (core.result.Result.Err (Reject.EndianImm pc))
        else ok (core.result.Result.Ok ())
      else ok (core.result.Result.Ok ())
    else ok (core.result.Result.Ok ())
  | Op.Load _ _ => ok (core.result.Result.Ok ())
  | Op.StoreImm _ => ok (core.result.Result.Ok ())
  | Op.StoreReg _ => ok (core.result.Result.Ok ())
  | Op.LoadImm64 =>
    if insn.src != 0#u8
    then ok (core.result.Result.Err (Reject.LddwSrc pc))
    else
      let i ← pc + 1#usize
      if i >= num_insns
      then ok (core.result.Result.Err (Reject.IncompleteLddw pc))
      else
        let i1 ← Slice.index_usize insns i
        if i1.opcode != 0#u8
        then ok (core.result.Result.Err (Reject.IncompleteLddw pc))
        else
          let high ← Slice.index_usize insns i
          if high.dst != 0#u8
          then ok (core.result.Result.Err (Reject.LddwSecondHalf i))
          else
            if high.src != 0#u8
            then ok (core.result.Result.Err (Reject.LddwSecondHalf i))
            else
              if high.offset != 0#i16
              then ok (core.result.Result.Err (Reject.LddwSecondHalf i))
