  if cross_section
  then
    if insn.src != 2#u8
    then ok (core.result.Result.Err (Reject.CrossSectionMetadata pc))
    else
      if insn.src = 0#u8
      then
        if insn.imm < 0#i32
        then ok (core.result.Result.Err (Reject.HelperImm pc))
        else
          let i ← lift (IScalar.hcast .U32 insn.imm)
          let b ← helper_known config known_helpers i
          if b
          then ok (core.result.Result.Ok ())
          else ok (core.result.Result.Err (Reject.UnknownHelper pc))
      else
        if insn.src = 1#u8
        then
          let i ← lift (UScalar.hcast .I64 pc)
          let i1 ← i + 1#i64
          let i2 ← lift (IScalar.cast .I64 insn.imm)
          let target ← i1 + i2
          if target < 0#i64
          then ok (core.result.Result.Err (Reject.LocalCallOutOfBounds pc))
          else
            let i3 ← lift (UScalar.hcast .I64 num_insns)
            if target >= i3
            then ok (core.result.Result.Err (Reject.LocalCallOutOfBounds pc))
            else
              let i4 ← lift (IScalar.hcast .Usize target)
              let i5 ← Slice.index_usize insns i4
              if i5.opcode = 0#u8
              then ok (core.result.Result.Err (Reject.CallIntoLddw pc))
              else ok (core.result.Result.Ok ())
        else
          if insn.src = 2#u8
          then ok (core.result.Result.Ok ())
          else ok (core.result.Result.Err (Reject.CallType pc))
  else
    if insn.src = 0#u8
    then
      if insn.imm < 0#i32
      then ok (core.result.Result.Err (Reject.HelperImm pc))
      else
        let i ← lift (IScalar.hcast .U32 insn.imm)
        let b ← helper_known config known_helpers i
        if b
        then ok (core.result.Result.Ok ())
        else ok (core.result.Result.Err (Reject.UnknownHelper pc))
    else
      if insn.src = 1#u8
      then
        let i ← lift (UScalar.hcast .I64 pc)
        let i1 ← i + 1#i64
        let i2 ← lift (IScalar.cast .I64 insn.imm)
        let target ← i1 + i2
        if target < 0#i64
        then ok (core.result.Result.Err (Reject.LocalCallOutOfBounds pc))
        else
          let i3 ← lift (UScalar.hcast .I64 num_insns)
          if target >= i3
          then ok (core.result.Result.Err (Reject.LocalCallOutOfBounds pc))
