/-- [ebpf_validate::decode]:
    Source: 'src/lib.rs', lines 359:0-468:1
    Visibility: public -/
def decode (opcode : Std.U8) : Result (Option Op) := do
  let i ← lift (opcode &&& SRC_REG)
  let source ← if i != 0#u8
                 then ok Source.Reg
                 else ok Source.Imm
  let cls ← lift (opcode &&& CLS_MASK)
  if cls = CLS_ALU
  then
    let width ← if cls = CLS_ALU64
                  then ok AluWidth.W64
                  else ok AluWidth.W32
    let i1 ← lift (opcode &&& ALU_MASK)
    if i1 = ALU_END
    then
      match width with
      | AluWidth.W32 =>
        match source with
        | Source.Imm => ok (some (Op.End EndKind.Le))
        | Source.Reg => ok (some (Op.End EndKind.Be))
      | AluWidth.W64 =>
        match source with
        | Source.Imm => ok (some (Op.End EndKind.Bswap))
        | Source.Reg => ok none
    else
      let i2 ← lift (opcode &&& ALU_MASK)
      let o ← alu_op_from_nibble i2
      match o with
      | none => ok none
      | some op =>
        let b ← is_neg op
        if b
        then
          let b1 ← is_reg source
          if b1
          then ok none
          else ok (some (Op.Alu width op source))
        else ok (some (Op.Alu width op source))
  else
    if cls = CLS_ALU64
    then
      let width ←
        if cls = CLS_ALU64
        then ok AluWidth.W64
        else ok AluWidth.W32
      let i1 ← lift (opcode &&& ALU_MASK)
      if i1 = ALU_END
      then
        match width with
        | AluWidth.W32 =>
          match source with
          | Source.Imm => ok (some (Op.End EndKind.Le))
          | Source.Reg => ok (some (Op.End EndKind.Be))
        | AluWidth.W64 =>
          match source with
          | Source.Imm => ok (some (Op.End EndKind.Bswap))
          | Source.Reg => ok none
      else
        let i2 ← lift (opcode &&& ALU_MASK)
        let o ← alu_op_from_nibble i2
        match o with
        | none => ok none
        | some op =>
          let b ← is_neg op
          if b
          then
            let b1 ← is_reg source
            if b1
            then ok none
            else ok (some (Op.Alu width op source))
          else ok (some (Op.Alu width op source))
    else
      if cls = CLS_LD
      then if opcode = OP_LDDW
           then ok (some Op.LoadImm64)
           else ok none
      else
        if cls = CLS_LDX
        then
          let i1 ← lift (opcode &&& SIZE_MASK)
          let o ← width_from_size_bits i1
          match o with
          | none => ok none
          | some width =>
            let mode ← lift (opcode &&& MODE_MASK)
            if mode = MODE_MEM
            then ok (some (Op.Load width false))
            else
              if mode = MODE_MEMSX
              then
                let b ← is_dw width
                if b
                then ok none
                else ok (some (Op.Load width true))
              else ok none
        else
          if cls = CLS_ST
          then
            let i1 ← lift (opcode &&& SIZE_MASK)
            let o ← width_from_size_bits i1
            match o with
            | none => ok none
            | some width =>
              let i2 ← lift (opcode &&& MODE_MASK)
              if i2 = MODE_MEM
              then ok (some (Op.StoreImm width))
              else ok none
          else
            if cls = CLS_STX
            then
              let i1 ← lift (opcode &&& SIZE_MASK)
              let o ← width_from_size_bits i1
              match o with
              | none => ok none
              | some width =>
                let mode ← lift (opcode &&& MODE_MASK)
                if mode = MODE_MEM
                then ok (some (Op.StoreReg width))
                else
                  if mode = MODE_ATOMIC
                  then
                    let b ← is_w width
                    if b
                    then ok (some (Op.Atomic width))
                    else
                      let b1 ← is_dw width
                      if b1
                      then ok (some (Op.Atomic width))
                      else ok none
                  else ok none
            else
              let width ←
                if cls = CLS_JMP32
                then ok AluWidth.W32
                else ok AluWidth.W64
              let nibble ← lift (opcode &&& JMP_MASK)
              if nibble = JMP_JA
              then
                let b ← is_reg source
                if b
                then ok none
                else ok (some (Op.Ja width))
              else
                if nibble = JMP_CALL
                then
                  let b ← is_w64 width
                  if b
                  then
                    let b1 ← is_reg source
                    if b1
                    then ok none
                    else ok (some Op.Call)
                  else ok none
                else
                  if nibble = JMP_EXIT
                  then
                    let b ← is_w64 width
                    if b
                    then
                      let b1 ← is_reg source
                      if b1
                      then ok none
                      else ok (some Op.Exit)
                    else ok none
                  else
                    let o ← jmp_op_from_nibble nibble
                    match o with
                    | none => ok none
                    | some op => ok (some (Op.Jmp width op source))

