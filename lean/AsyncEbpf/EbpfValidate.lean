def width_from_size_bits (bits : Std.U8) : Result (Option Width) := do
  if bits = SIZE_B
  then ok (some Width.B)
  else
    if bits = SIZE_H
    then ok (some Width.H)
    else
      if bits = SIZE_W
      then ok (some Width.W)
      else if bits = SIZE_DW
           then ok (some Width.DW)
           else ok none

