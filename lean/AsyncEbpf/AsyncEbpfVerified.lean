                core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
                  Bool (core.convert.FromSame validate.Reject) residual
            else ok (core.result.Result.Err (validate.Reject.InvalidDst pc))
          else ok (core.result.Result.Err (validate.Reject.InvalidDst pc))
        else
          let r1 ← validate.check_operand_filter insn pc
          let cf1 ← core.result.Result.Insts.CoreOpsTry.branch r1
          match cf1 with
          | core.ops.control_flow.ControlFlow.Continue _ =>
            let b ← validate.is_load_imm64 op
            ok (core.result.Result.Ok b)
          | core.ops.control_flow.ControlFlow.Break residual =>
            core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
              Bool (core.convert.FromSame validate.Reject) residual
    | core.ops.control_flow.ControlFlow.Break residual =>
      core.result.Result.Insts.CoreOpsTryTraitFromResidualResultInfallible.from_residual
        Bool (core.convert.FromSame validate.Reject) residual

