        insn op
    let cf ← core.result.Result.Insts.CoreOpsTry.branch r
    match cf with
    | core.ops.control_flow.ControlFlow.Continue _ =>
      if insn.src > 10#u8
      then ok (core.result.Result.Err (validate.Reject.InvalidSrc pc))
      else
        if insn.dst > 9#u8
