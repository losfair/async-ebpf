def x64_lower.needs_guest_fp
  (cfg : x64_ir.Cfg) (insn : isa.Insn) : Result Bool := do
  let active ← x64_ir.Cfg.native_frame_base_active cfg
  if active
  then
    if insn.src != 10#u8
    then ok false
    else x64_lower.reads_src_as_value insn
  else ok false

