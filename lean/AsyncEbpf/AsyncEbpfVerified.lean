def stack.mul_checked
  (a : Std.Usize) (b : Std.Usize) : Result (Option Std.Usize) := do
  if b != 0#usize
  then
    let i ← core.num.Usize.MAX / b
    if a > i
    then ok none
    else let i1 ← a * b
         ok (some i1)
  else let i ← a * b
       ok (some i)

