          if signed
          then
            do
            let out3 ←
              x64_expand.expand_muldiv_overflow w64 true label after_divide
                out1
            let next1 ← label + 2#u32
            ok (out3, next1)
          else ok (out1, label)
        ok (signed, v, mod_, i)
      else
        do
        let (b, v, i) ←
