def stack.in_frame_window
  (frame_size : Std.U16) (offset : Std.I16) (width : Std.U8) :
  Result Bool
  := do
  let offset1 ← lift (IScalar.cast .I32 offset)
  let width1 ← lift (UScalar.hcast .I32 width)
  let i ← lift (UScalar.hcast .I32 frame_size)
  let i1 ← -. i
