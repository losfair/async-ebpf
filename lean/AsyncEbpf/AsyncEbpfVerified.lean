def validate.check_structure
  (config : validate.Config) (known_helpers : Slice Std.U32)
  (insns : Slice isa.Insn) (external_calls : Slice Bool) (pc : Std.Usize)
  (insn : isa.Insn) (op : isa.Op) :
  Result (core.result.Result Unit validate.Reject)
  := do
  let num_insns := Slice.len insns
  match op with
  | isa.Op.Alu _ ao _ =>
    match ao with
    | isa.AluOp.Add => ok (core.result.Result.Ok ())
    | isa.AluOp.Sub => ok (core.result.Result.Ok ())
    | isa.AluOp.Mul => ok (core.result.Result.Ok ())
    | isa.AluOp.Div => ok (core.result.Result.Ok ())
    | isa.AluOp.Or => ok (core.result.Result.Ok ())
    | isa.AluOp.And => ok (core.result.Result.Ok ())
    | isa.AluOp.Lsh => ok (core.result.Result.Ok ())
    | isa.AluOp.Rsh => ok (core.result.Result.Ok ())
    | isa.AluOp.Neg =>
      if insn.src != 0#u8
      then ok (core.result.Result.Err (validate.Reject.NegSrc pc))
      else ok (core.result.Result.Ok ())
    | isa.AluOp.Mod => ok (core.result.Result.Ok ())
    | isa.AluOp.Xor => ok (core.result.Result.Ok ())
    | isa.AluOp.Mov => ok (core.result.Result.Ok ())
    | isa.AluOp.Arsh => ok (core.result.Result.Ok ())
  | isa.Op.End _ =>
    if insn.imm != 16#i32
    then
      if insn.imm != 32#i32
      then
        if insn.imm != 64#i32
        then ok (core.result.Result.Err (validate.Reject.EndianImm pc))
        else ok (core.result.Result.Ok ())
      else ok (core.result.Result.Ok ())
    else ok (core.result.Result.Ok ())
  | isa.Op.Load _ _ => ok (core.result.Result.Ok ())
  | isa.Op.StoreImm _ => ok (core.result.Result.Ok ())
  | isa.Op.StoreReg _ => ok (core.result.Result.Ok ())
  | isa.Op.LoadImm64 =>
    if insn.src != 0#u8
    then ok (core.result.Result.Err (validate.Reject.LddwSrc pc))
    else
      let i ← pc + 1#usize
      if i >= num_insns
      then ok (core.result.Result.Err (validate.Reject.IncompleteLddw pc))
      else
        let i1 ← Slice.index_usize insns i
        if i1.opcode != 0#u8
        then ok (core.result.Result.Err (validate.Reject.IncompleteLddw pc))
        else
          let high ← Slice.index_usize insns i
          if high.dst != 0#u8
          then ok (core.result.Result.Err (validate.Reject.LddwSecondHalf i))
          else
            if high.src != 0#u8
            then ok (core.result.Result.Err (validate.Reject.LddwSecondHalf i))
            else
              if high.offset != 0#i16
              then
                ok (core.result.Result.Err (validate.Reject.LddwSecondHalf i))
              else ok (core.result.Result.Ok ())
  | isa.Op.Atomic _ _ _ => validate.check_atomic_selector insn pc
  | isa.Op.Ja _ => validate.check_jump insns pc insn
  | isa.Op.Jmp _ _ _ => validate.check_jump insns pc insn
  | isa.Op.Call =>
    let i := Slice.len external_calls
    let cross_section ←
      if pc < i
      then Slice.index_usize external_calls pc
      else ok false
    validate.check_call config known_helpers insn insns pc cross_section
  | isa.Op.Exit => ok (core.result.Result.Ok ())

