          alloc.vec.Vec.push out (x64_ir.PInsn.Alu false x64_ir.AluRR.Xor dst
            dst)
        ok (label, out1)
      else
        if mul
        then
          let out1 ←
            alloc.vec.Vec.push out (x64_ir.PInsn.Alu false x64_ir.AluRR.Xor dst
              dst)
          ok (label, out1)
        else
          let p ← x64_expand.mov64 dst dst
