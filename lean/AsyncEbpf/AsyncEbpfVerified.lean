        | region.RegKind.Stack _ => region.invalidate_slots s2.spills
        | region.RegKind.Data => ok s2.spills
        | region.RegKind.Scalar => region.invalidate_slots s2.spills
        | region.RegKind.Unknown => region.invalidate_slots s2.spills
