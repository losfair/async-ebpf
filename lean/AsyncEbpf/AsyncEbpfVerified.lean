/-- [async_ebpf_verified::isa::decode]:
    Source: '../../src/verified/isa.rs', lines 330:0-449:1
    Visibility: public -/
def isa.decode (opcode : Std.U8) : Result (Option isa.Op) := do
  let i ← lift (opcode &&& isa.SRC_REG)
  let source ← if i != 0#u8
                 then ok isa.Source.Reg
                 else ok isa.Source.Imm
  let cls ← lift (opcode &&& isa.CLS_MASK)
  if cls = isa.CLS_ALU
  then
    let width ←
      if cls = isa.CLS_ALU64
      then ok isa.AluWidth.W64
      else ok isa.AluWidth.W32
    let i1 ← lift (opcode &&& isa.ALU_MASK)
    if i1 = isa.ALU_END
    then
      match width with
      | isa.AluWidth.W32 =>
        match source with
        | isa.Source.Imm => ok (some (isa.Op.End isa.EndKind.Le))
        | isa.Source.Reg => ok (some (isa.Op.End isa.EndKind.Be))
      | isa.AluWidth.W64 =>
        match source with
        | isa.Source.Imm => ok (some (isa.Op.End isa.EndKind.Bswap))
        | isa.Source.Reg => ok none
    else
      let i2 ← lift (opcode &&& isa.ALU_MASK)
      let o ← isa.alu_op_from_nibble i2
      match o with
      | none => ok none
      | some op =>
        let b ← isa.is_neg op
        if b
        then
          let b1 ← isa.is_reg source
          if b1
          then ok none
          else ok (some (isa.Op.Alu width op source))
        else ok (some (isa.Op.Alu width op source))
  else
    if cls = isa.CLS_ALU64
    then
      let width ←
        if cls = isa.CLS_ALU64
        then ok isa.AluWidth.W64
        else ok isa.AluWidth.W32
      let i1 ← lift (opcode &&& isa.ALU_MASK)
      if i1 = isa.ALU_END
      then
        match width with
        | isa.AluWidth.W32 =>
          match source with
          | isa.Source.Imm => ok (some (isa.Op.End isa.EndKind.Le))
          | isa.Source.Reg => ok (some (isa.Op.End isa.EndKind.Be))
        | isa.AluWidth.W64 =>
          match source with
          | isa.Source.Imm => ok (some (isa.Op.End isa.EndKind.Bswap))
          | isa.Source.Reg => ok none
      else
        let i2 ← lift (opcode &&& isa.ALU_MASK)
        let o ← isa.alu_op_from_nibble i2
        match o with
        | none => ok none
        | some op =>
          let b ← isa.is_neg op
          if b
          then
            let b1 ← isa.is_reg source
            if b1
            then ok none
            else ok (some (isa.Op.Alu width op source))
          else ok (some (isa.Op.Alu width op source))
    else
      if cls = isa.CLS_LD
      then if opcode = isa.OP_LDDW
           then ok (some isa.Op.LoadImm64)
           else ok none
      else
        if cls = isa.CLS_LDX
        then
          let i1 ← lift (opcode &&& isa.SIZE_MASK)
          let o ← isa.width_from_size_bits i1
          match o with
          | none => ok none
          | some width =>
            let mode ← lift (opcode &&& isa.MODE_MASK)
            if mode = isa.MODE_MEM
            then ok (some (isa.Op.Load width false))
            else
              if mode = isa.MODE_MEMSX
              then
                let b ← isa.is_dw width
                if b
                then ok none
                else ok (some (isa.Op.Load width true))
              else ok none
        else
          if cls = isa.CLS_ST
          then
            let i1 ← lift (opcode &&& isa.SIZE_MASK)
            let o ← isa.width_from_size_bits i1
            match o with
            | none => ok none
            | some width =>
              let i2 ← lift (opcode &&& isa.MODE_MASK)
              if i2 = isa.MODE_MEM
              then ok (some (isa.Op.StoreImm width))
              else ok none
          else
            if cls = isa.CLS_STX
            then
              let i1 ← lift (opcode &&& isa.SIZE_MASK)
              let o ← isa.width_from_size_bits i1
              match o with
              | none => ok none
              | some width =>
                let mode ← lift (opcode &&& isa.MODE_MASK)
                if mode = isa.MODE_MEM
                then ok (some (isa.Op.StoreReg width))
                else
                  if mode = isa.MODE_ATOMIC
                  then
                    let b ← isa.is_w width
                    if b
                    then ok (some (isa.Op.Atomic width isa.AtomicOp.Add false))
                    else
                      let b1 ← isa.is_dw width
                      if b1
                      then
                        ok (some (isa.Op.Atomic width isa.AtomicOp.Add false))
                      else ok none
                  else ok none
            else
              let width ←
                if cls = isa.CLS_JMP32
                then ok isa.AluWidth.W32
                else ok isa.AluWidth.W64
              let nibble ← lift (opcode &&& isa.JMP_MASK)
              if nibble = isa.JMP_JA
              then
                let b ← isa.is_reg source
                if b
                then ok none
                else ok (some (isa.Op.Ja width))
              else
                if nibble = isa.JMP_CALL
                then
                  let b ← isa.is_w64 width
                  if b
                  then
                    let b1 ← isa.is_reg source
                    if b1
                    then ok none
                    else ok (some isa.Op.Call)
                  else ok none
                else
                  if nibble = isa.JMP_EXIT
                  then
                    let b ← isa.is_w64 width
                    if b
                    then
                      let b1 ← isa.is_reg source
                      if b1
                      then ok none
                      else ok (some isa.Op.Exit)
                    else ok none
                  else
                    let o ← isa.jmp_op_from_nibble nibble
                    match o with
                    | none => ok none
                    | some op => ok (some (isa.Op.Jmp width op source))

