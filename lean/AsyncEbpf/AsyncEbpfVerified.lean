    | isa.AluOp.Mod => ok (core.result.Result.Ok ())
    | isa.AluOp.Xor => ok (core.result.Result.Ok ())
    | isa.AluOp.Mov => ok (core.result.Result.Ok ())
    | isa.AluOp.Arsh => ok (core.result.Result.Ok ())
  | isa.Op.End _ =>
    if insn.imm != 16#i32
    then
      if insn.imm != 32#i32
      then
        if insn.imm != 64#i32
        then ok (core.result.Result.Err (validate.Reject.EndianImm pc))
        else ok (core.result.Result.Ok ())
      else ok (core.result.Result.Ok ())
    else ok (core.result.Result.Ok ())
  | isa.Op.Load _ _ => ok (core.result.Result.Ok ())
  | isa.Op.StoreImm _ => ok (core.result.Result.Ok ())
  | isa.Op.StoreReg _ => ok (core.result.Result.Ok ())
  | isa.Op.LoadImm64 =>
    if insn.src != 0#u8
    then ok (core.result.Result.Err (validate.Reject.LddwSrc pc))
    else
