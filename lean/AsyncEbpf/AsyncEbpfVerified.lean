    Visibility: public -/
def validate.check_atomic_selector
  (insn : isa.Insn) (pc : Std.Usize) :
  Result (core.result.Result Unit validate.Reject)
  := do
  let i ← lift (insn.imm &&& isa.ATOMIC_OP_FETCH)
  let i1 ← lift (UScalar.hcast .I32 isa.ALU_MASK)
  let op ← lift (insn.imm &&& i1)
  let i2 ← lift (UScalar.hcast .I32 isa.ALU_ADD)
  if op = i2
  then ok (core.result.Result.Ok ())
  else
    let i3 ← lift (UScalar.hcast .I32 isa.ALU_OR)
    if op = i3
    then ok (core.result.Result.Ok ())
    else
      let i4 ← lift (UScalar.hcast .I32 isa.ALU_AND)
      if op = i4
      then ok (core.result.Result.Ok ())
      else
        let i5 ← lift (UScalar.hcast .I32 isa.ALU_XOR)
        if op = i5
        then ok (core.result.Result.Ok ())
        else
          let i6 ← lift (~~~ isa.ATOMIC_OP_FETCH)
          let i7 ← lift (isa.ATOMIC_OP_XCHG &&& i6)
          if op = i7
          then
            if i != 0#i32
            then ok (core.result.Result.Ok ())
            else
              ok (core.result.Result.Err (validate.Reject.AtomicNeedsFetch pc))
          else
            let i8 ← lift (~~~ isa.ATOMIC_OP_FETCH)
            let i9 ← lift (isa.ATOMIC_OP_CMPXCHG &&& i8)
            if op = i9
            then
              if i != 0#i32
              then ok (core.result.Result.Ok ())
              else
                ok (core.result.Result.Err (validate.Reject.AtomicNeedsFetch
                  pc))
            else ok (core.result.Result.Err (validate.Reject.AtomicUnknown pc))

