def x64_lower.prologue_needs_skip
  (insns : Slice isa.Insn) (entries : Slice Bool) (start_pc : Std.Usize)
  (pc : Std.Usize) :
  Result Bool
  := do
  if pc = start_pc
  then ok false
  else
    let entry ← x64_lower.is_func_entry entries pc
    if entry
    then
      let i ← pc - 1#usize
