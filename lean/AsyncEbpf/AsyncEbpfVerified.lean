  let b ← x64_layout.fits l.native_stack_lo x64_layout.NATIVE_CALL_RESERVE
  if b
  then
    let i ← l.native_stack_lo + x64_layout.NATIVE_CALL_RESERVE
    ok (i <= l.native_floor)
  else ok false

