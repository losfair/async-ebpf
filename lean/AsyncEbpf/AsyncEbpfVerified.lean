  (kind : x64_ir.MulDivKind) (w64 : Bool) (reg : Bool) (signed : Bool)
  (src : Std.U8) (dst : Std.U8) (imm : Std.I32) (label : Std.U32)
  (out : alloc.vec.Vec x64_ir.PInsn) :
