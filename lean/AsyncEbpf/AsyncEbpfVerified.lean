    if cc = 131#u8
    then ok (¬ f.cf)
    else
      if cc = 132#u8
      then ok f.zf
      else
        if cc = 133#u8
        then ok (¬ f.zf)
        else
          if cc = 134#u8
          then if f.cf
               then ok true
               else ok f.zf
          else
