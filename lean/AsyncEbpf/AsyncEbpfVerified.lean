    then ok (some isa.AluOp.Sub)
    else
      if nibble = isa.ALU_MUL
      then ok (some isa.AluOp.Mul)
      else
        if nibble = isa.ALU_DIV
        then ok (some isa.AluOp.Div)
        else
          if nibble = isa.ALU_OR
          then ok (some isa.AluOp.Or)
          else
            if nibble = isa.ALU_AND
            then ok (some isa.AluOp.And)
            else
              if nibble = isa.ALU_LSH
              then ok (some isa.AluOp.Lsh)
              else
                if nibble = isa.ALU_RSH
                then ok (some isa.AluOp.Rsh)
                else
                  if nibble = isa.ALU_NEG
                  then ok (some isa.AluOp.Neg)
                  else
                    if nibble = isa.ALU_MOD
                    then ok (some isa.AluOp.Mod)
                    else
                      if nibble = isa.ALU_XOR
                      then ok (some isa.AluOp.Xor)
                      else
                        if nibble = isa.ALU_MOV
                        then ok (some isa.AluOp.Mov)
                        else
                          if nibble = isa.ALU_ARSH
                          then ok (some isa.AluOp.Arsh)
