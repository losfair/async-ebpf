  Result (ControlFlow (x64_lower.Lowering × Std.U8) x64_lower.Lowering)
  := do
  if reg < 16#u8
  then
    let i ← 1#u16 <<< reg
    let i1 ← lift (mask &&& i)
    let st1 ←
      if i1 != 0#u16
      then x64_lower.note_register_written st reg
      else ok st
    let reg1 ← reg + 1#u8
    ok (cont (st1, reg1))
  else ok (done st)

