def x64_lower.branch_delta (insn : isa.Insn) : Result Std.I64 := do
  if insn.opcode = isa.OP_JA32
  then ok (IScalar.cast .I64 insn.imm)
  else ok (IScalar.cast .I64 insn.offset)

/-- [async_ebpf_verified::x64_lower::is_barrier]:
