/-- [async_ebpf_verified::validate::offset_ok]:
    Source: '../../src/verified/validate.rs', lines 183:0-191:1
    Visibility: public -/
def validate.offset_ok
  (opcode : Std.U8) (f : validate.Filter) (offset : Std.I16) :
  Result Bool
  := do
  if opcode = 188#u8
  then
    if offset = 0#i16
    then ok true
    else if offset = 8#i16
         then ok true
         else ok (offset = 16#i16)
  else
    if opcode = 191#u8
    then
      if offset = 0#i16
      then ok true
      else
        if offset = 8#i16
        then ok true
        else if offset = 16#i16
             then ok true
             else ok (offset = 32#i16)
    else if offset >= f.off_lo
         then ok (offset <= f.off_hi)
         else ok false

/-- [async_ebpf_verified::validate::imm_ok]:
    Source: '../../src/verified/validate.rs', lines 195:0-210:1
    Visibility: public -/
def validate.imm_ok
  (opcode : Std.U8) (f : validate.Filter) (imm : Std.I32) : Result Bool := do
  if opcode = 219#u8
  then
    if imm = 0#i32
    then ok true
    else
      if imm = 1#i32
      then ok true
      else
        if imm = 64#i32
        then ok true
        else
          if imm = 65#i32
          then ok true
          else
            if imm = 80#i32
            then ok true
            else
              if imm = 81#i32
              then ok true
              else
                if imm = 160#i32
                then ok true
                else
                  if imm = 161#i32
                  then ok true
                  else if imm = 225#i32
                       then ok true
                       else ok (imm = 241#i32)
  else if imm >= f.imm_lo
       then ok (imm <= f.imm_hi)
       else ok false

/-- [async_ebpf_verified::validate::check_operand_filter]:
    Source: '../../src/verified/validate.rs', lines 214:0-231:1
    Visibility: public -/
def validate.check_operand_filter
  (insn : isa.Insn) (pc : Std.Usize) :
  Result (core.result.Result Unit validate.Reject)
  := do
  let o ← validate.filter_for insn.opcode
  match o with
  | none => ok (core.result.Result.Err (validate.Reject.FilterOpcode pc))
  | some f =>
    if insn.dst < f.dst_lo
    then ok (core.result.Result.Err (validate.Reject.FilterDst pc))
    else
      if insn.dst > f.dst_hi
      then ok (core.result.Result.Err (validate.Reject.FilterDst pc))
      else
        if insn.src < f.src_lo
        then ok (core.result.Result.Err (validate.Reject.FilterSrc pc))
        else
          if insn.src > f.src_hi
          then ok (core.result.Result.Err (validate.Reject.FilterSrc pc))
          else
            let b ← validate.imm_ok insn.opcode f insn.imm
            if b
            then
              let b1 ← validate.offset_ok insn.opcode f insn.offset
              if b1
              then ok (core.result.Result.Ok ())
              else
                ok (core.result.Result.Err (validate.Reject.FilterOffset pc))
            else ok (core.result.Result.Err (validate.Reject.FilterImm pc))

/-- [async_ebpf_verified::validate::check_atomic_selector]:
    Source: '../../src/verified/validate.rs', lines 238:0-251:1
    Visibility: public -/
def validate.check_atomic_selector
  (insn : isa.Insn) (pc : Std.Usize) :
  Result (core.result.Result Unit validate.Reject)
  := do
  let i ← lift (insn.imm &&& isa.ATOMIC_OP_FETCH)
  let i1 ← lift (UScalar.hcast .I32 isa.ALU_MASK)
  let op ← lift (insn.imm &&& i1)
  let i2 ← lift (UScalar.hcast .I32 isa.ALU_ADD)
  if op = i2
