    match ao with
    | isa.AluOp.Add => ok (core.result.Result.Ok ())
    | isa.AluOp.Sub => ok (core.result.Result.Ok ())
    | isa.AluOp.Mul => ok (core.result.Result.Ok ())
    | isa.AluOp.Div => ok (core.result.Result.Ok ())
    | isa.AluOp.Or => ok (core.result.Result.Ok ())
    | isa.AluOp.And => ok (core.result.Result.Ok ())
    | isa.AluOp.Lsh => ok (core.result.Result.Ok ())
    | isa.AluOp.Rsh => ok (core.result.Result.Ok ())
